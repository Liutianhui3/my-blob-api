PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=my_blob_api
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# AI_BASE_URL includes the API version path (e.g. /v1), not /chat/completions.
# Use a provider that supports Chat Completions, stream=true and max_tokens.
AI_API_KEY=
AI_BASE_URL=https://xcode.best/v1
AI_MODEL=gpt-6.1-sol
# Optional JSON allowlist. Include AI_MODEL. Configure only levels your provider supports.
# Use tokenParameter=max_completion_tokens for models that require the newer parameter.
AI_MODELS=[{"id":"gpt-6.1-sol","label":"6.1 Sol","reasoningEfforts":["low","medium","high","xhigh","max"],"defaultEffort":"auto","tokenParameter":"max_tokens"},{"id":"gpt-6-astra","label":"6 Astra","reasoningEfforts":["low","medium","high","xhigh","max"]},{"id":"gpt-6-sol","label":"6 Sol","reasoningEfforts":["low","medium","high","xhigh","max"]},{"id":"gpt-5.6-sol","label":"5.6 Sol","reasoningEfforts":["low","medium","high","xhigh","max"]}]
AI_SYSTEM_PROMPT=你是一个有帮助的中文助手。
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=2048
# Conservative UTF-8 byte budget, not an exact tokenizer count.
AI_CONTEXT_MAX_BYTES=24000
